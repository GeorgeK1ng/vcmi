       <item>
        <widget class="QLabel" name="labelWelcomeTitle">
         <property name="font">
          <font>
           <pointsize>12</pointsize>
           <bold>false</bold>
          </font>
         </property>
         <property name="text">
          <string>Welcome to VCMI</string>
